[Icon Theme]
Name=Ferrite
Comment=Thème d'icônes de ferrite-linux — squircles, dégradés doux, glyphes épurés
Inherits=Adwaita,hicolor
Example=folder
Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes

[scalable/apps]
Context=Applications
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=16
MaxSize=512
Type=Scalable
