cat > "$t/Ferrite/gtk-4.0/gtk.css" <<'FIN_FERRITE'
/* Ferrite — couleurs pour GTK 4 et libadwaita. Fichier généré par ferrite-theme/gtk/generer.py.
   Installé dans ~/.config/gtk-4.0/gtk.css : GTK 4 le lit après le thème de l'application. */
@define-color accent_color #B83A0A;
@define-color accent_bg_color #B83A0A;
@define-color accent_fg_color #FFFFFF;
@define-color destructive_color #C62828;
@define-color destructive_bg_color #C62828;
@define-color destructive_fg_color #FFFFFF;
@define-color success_color #137333;
@define-color warning_color #8F5200;
@define-color error_color #C62828;
@define-color window_bg_color #F4F4F6;
@define-color window_fg_color #1B1B1F;
@define-color view_bg_color #FFFFFF;
@define-color view_fg_color #1B1B1F;
@define-color headerbar_bg_color #EBEBEF;
@define-color headerbar_fg_color #1B1B1F;
@define-color headerbar_backdrop_color #F4F4F6;
@define-color sidebar_bg_color #EBEBEF;
@define-color sidebar_fg_color #1B1B1F;
@define-color card_bg_color #FFFFFF;
@define-color card_fg_color #1B1B1F;
@define-color dialog_bg_color #FFFFFF;
@define-color dialog_fg_color #1B1B1F;
@define-color popover_bg_color #FFFFFF;
@define-color popover_fg_color #1B1B1F;
:root {
  --accent-color: #B83A0A;
  --accent-bg-color: #B83A0A;
  --accent-fg-color: #FFFFFF;
  --destructive-color: #C62828;
  --destructive-bg-color: #C62828;
  --destructive-fg-color: #FFFFFF;
  --success-color: #137333;
  --warning-color: #8F5200;
  --error-color: #C62828;
  --window-bg-color: #F4F4F6;
  --window-fg-color: #1B1B1F;
  --view-bg-color: #FFFFFF;
  --view-fg-color: #1B1B1F;
  --headerbar-bg-color: #EBEBEF;
  --headerbar-fg-color: #1B1B1F;
  --headerbar-backdrop-color: #F4F4F6;
  --sidebar-bg-color: #EBEBEF;
  --sidebar-fg-color: #1B1B1F;
  --card-bg-color: #FFFFFF;
  --card-fg-color: #1B1B1F;
  --dialog-bg-color: #FFFFFF;
  --dialog-fg-color: #1B1B1F;
  --popover-bg-color: #FFFFFF;
  --popover-fg-color: #1B1B1F;
  --window-radius: 14px;
}
@media (prefers-color-scheme: dark) {
  @define-color accent_color #FF7A45;
  @define-color accent_bg_color #FF7A45;
  @define-color accent_fg_color #1A0B04;
  @define-color destructive_color #F87171;
  @define-color destructive_bg_color #F87171;
  @define-color destructive_fg_color #1F0707;
  @define-color success_color #4ADE80;
  @define-color warning_color #FBBF24;
  @define-color error_color #F87171;
  @define-color window_bg_color #141416;
  @define-color window_fg_color #F2F2F5;
  @define-color view_bg_color #1E1E22;
  @define-color view_fg_color #F2F2F5;
  @define-color headerbar_bg_color #19191C;
  @define-color headerbar_fg_color #F2F2F5;
  @define-color headerbar_backdrop_color #141416;
  @define-color sidebar_bg_color #19191C;
  @define-color sidebar_fg_color #F2F2F5;
  @define-color card_bg_color #1E1E22;
  @define-color card_fg_color #F2F2F5;
  @define-color dialog_bg_color #1E1E22;
  @define-color dialog_fg_color #F2F2F5;
  @define-color popover_bg_color #1E1E22;
  @define-color popover_fg_color #F2F2F5;
  :root {
    --accent-color: #FF7A45;
    --accent-bg-color: #FF7A45;
    --accent-fg-color: #1A0B04;
    --destructive-color: #F87171;
    --destructive-bg-color: #F87171;
    --destructive-fg-color: #1F0707;
    --success-color: #4ADE80;
    --warning-color: #FBBF24;
    --error-color: #F87171;
    --window-bg-color: #141416;
    --window-fg-color: #F2F2F5;
    --view-bg-color: #1E1E22;
    --view-fg-color: #F2F2F5;
    --headerbar-bg-color: #19191C;
    --headerbar-fg-color: #F2F2F5;
    --headerbar-backdrop-color: #141416;
    --sidebar-bg-color: #19191C;
    --sidebar-fg-color: #F2F2F5;
    --card-bg-color: #1E1E22;
    --card-fg-color: #F2F2F5;
    --dialog-bg-color: #1E1E22;
    --dialog-fg-color: #F2F2F5;
    --popover-bg-color: #1E1E22;
    --popover-fg-color: #F2F2F5;
    --window-radius: 14px;
  }
}
FIN_FERRITE
cat > "$t/Ferrite/index.theme" <<'FIN_FERRITE'
[Desktop Entry]
Type=X-GNOME-Metatheme
Name=Ferrite
Comment=Thème de Ferrite OS : neutres calmes et accent Oxyde
Encoding=UTF-8

[X-GNOME-Metatheme]
GtkTheme=Ferrite
IconTheme=Ferrite
CursorTheme=Ferrite-Cursors
FIN_FERRITE
cat > "$t/Ferrite-dark/index.theme" <<'FIN_FERRITE'
[Desktop Entry]
Type=X-GNOME-Metatheme
Name=Ferrite-dark
Comment=Thème de Ferrite OS : neutres calmes et accent Oxyde
Encoding=UTF-8

[X-GNOME-Metatheme]
GtkTheme=Ferrite-dark
IconTheme=Ferrite
CursorTheme=Ferrite-Cursors
FIN_FERRITE
cp "$t/Ferrite/gtk-4.0/gtk.css" /etc/skel/.config/gtk-4.0/gtk.css
if [ -d /home/user ]; then
    mkdir -p /home/user/.config/gtk-4.0
    cp "$t/Ferrite/gtk-4.0/gtk.css" /home/user/.config/gtk-4.0/gtk.css
    chown -R --reference=/home/user /home/user/.config/gtk-4.0 2>/dev/null || true
fi
for v in 3.0 4.0; do
    printf '[Settings]\ngtk-theme-name=Ferrite\ngtk-font-name=Inter 10.5\n' > "/etc/gtk-$v/settings.ini"
done
printf "[org.gnome.desktop.interface]\ngtk-theme='Ferrite'\nfont-name='Inter 10.5'\n" \
    > /usr/share/glib-2.0/schemas/91_ferrite-gtk.gschema.override
glib-compile-schemas /usr/share/glib-2.0/schemas
