#!/bin/sh
# Clé live : le mot de passe de l'utilisateur « ferrite » devient « ferrite » au lieu de
# « live » (codé en dur dans live-config). Il est annoncé par l'assistant de bienvenue,
# l'écran de verrouillage et la console. Le compte créé à l'installation a le sien.
# Empreinte : openssl passwd -6 -salt ferritelive ferrite
set -eu
script=/usr/lib/live/config/0030-user-setup
grep -q '^	_PASSWORD="8Ab05sVQ4LLps"$' "$script" || {
    echo "0150-ferrite-live-password : mot de passe de live-config introuvable dans $script" >&2
    exit 1
}
# shellcheck disable=SC2016 # Les « $ » de l'empreinte sont voulus, sans expansion.
sed -i 's|^	_PASSWORD="8Ab05sVQ4LLps"$|	_PASSWORD='"'"'$6$ferritelive$cNOkdMLOZw7zZ18Ldsow13y/2duRFkhk9SkzqJjLoqlW7XmnDShkuLkbXhaPqFBiW1Y0AJbAUIuSvlXdT/wXl0'"'"'|' "$script"
grep -q 'ferritelive' "$script"
