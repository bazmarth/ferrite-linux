#!/bin/sh
# Session Ferrite, lancée par l'écran de connexion (greetd, option --greetd) ou à la
# connexion sur tty1 : le bureau ferrite-shell, ouvert sur
# l'espace des widgets (aucune application lancée d'office). Si le bureau ne démarre pas (ou quand on le quitte avec Ctrl+Alt+Retour
# arrière), on retombe sur la console avec les commandes utiles.
set -u
# Lancée par greetd : à la fin de la session, on revient à l'écran de connexion (pas de
# console), et le bureau ne redemande pas le mot de passe qui vient d'être donné.
greetd=0
[ "${1:-}" = --greetd ] && greetd=1
export FERRITE_SESSION=1
export XDG_CURRENT_DESKTOP=Ferrite
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=ferrite
# Les terminaux du bureau ouvrent fish (complétion par Tab, suggestions au fil de la
# frappe) ; la connexion sur tty1 reste en sh/bash, qui lit /etc/profile.d.
case "${SHELL:-}" in
    "" | */sh | */bash | */dash)
        [ -x /usr/bin/fish ] && export SHELL=/usr/bin/fish
        ;;
esac

log="${XDG_RUNTIME_DIR:-/tmp}/ferrite-shell.log"

# Bus D-Bus de la session : celui de systemd (--user) quand il existe. Le coffre à mots de
# passe (gnome-keyring), le son et les portails y tournent déjà ; un bus à part
# (dbus-run-session) ne trouvait pas le coffre, et Brave ou Claude l'attendaient 2 minutes
# au démarrage.
user_bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
if [ -S "$user_bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$user_bus"
    bus=""
else
    bus="dbus-run-session --"
fi

# Mode développement : les binaires compilés remplacent ceux de /usr/local/bin, et quitter
# le bureau (Ctrl+Alt+Retour arrière) le relance avec la dernière version. Deux sources :
# - le partage « ferrite-dev » de QEMU (voir ferrite-dev.service) ;
# - sur le disque, le dossier rempli par tools/dev-on.sh (vidé par tools/dev-off.sh).
# Une version de développement qui plante deux fois de suite est écartée : la session repart
# sur les binaires stables jusqu'à la prochaine copie par tools/dev-on.sh.
stable=/usr/local/bin
disk_dev="${XDG_DATA_HOME:-$HOME/.local/share}/ferrite-dev"
system_path=$PATH
rejected=""

# Choisit $bin et $dev pour le prochain lancement (relu à chaque tour de boucle).
choose_bin() {
    bin=$stable
    dev=0
    for candidate in /run/ferrite-dev "$disk_dev"; do
        [ -x "$candidate/ferrite-shell" ] || continue
        [ "$candidate:$(stat -c %Y "$candidate/ferrite-shell")" = "$rejected" ] && continue
        bin=$candidate
        dev=1
        printf '\n  Mode développement : binaires de %s\n' "$bin"
        return
    done
}

# Le bureau redémarre seul s'il s'arrête sur une erreur ; après 3 arrêts en moins de
# 2 minutes, on retombe sur la console pour ne pas boucler. Ctrl+Alt+Retour arrière
# (code 0) ramène directement à la console.
crashes=0
dev_crashes=0
window_start=$(date +%s)
first=1
# Le bureau démarre sur l'écran de verrouillage (la connexion sur tty1 est automatique),
# sauf quand on le relance soi-même en mode développement. Pas au démarrage de la clé live
# (elle s'ouvre seule) ; son mot de passe, « ferrite », sert au verrouillage et aux droits
# d'administrateur (voir le crochet 0150-ferrite-live-password).
if [ "$greetd" = 1 ] || grep -qw "boot=live" /proc/cmdline 2>/dev/null; then
    lock_default=0
else
    lock_default=1
fi
lock=$lock_default
choose_bin
while [ -x "$bin/ferrite-shell" ]; do
    # Les applications lancées par le bureau viennent du même dossier que lui.
    if [ "$dev" = 1 ]; then
        PATH="$bin:$system_path"
    else
        PATH=$system_path
    fi
    export PATH
    if [ "$first" = 1 ]; then
        printf '\n  Démarrage du bureau Ferrite… (journal : %s)\n' "$log"
    else
        printf '\n  Redémarrage du bureau Ferrite…\n'
    fi
    first=0
    [ -f "$log" ] && mv -f "$log" "$log.precedent"
    # shellcheck disable=SC2086 # $bus est vide ou « dbus-run-session -- ».
    # FERRITE_DEV=1 : le dialogue d'arrêt propose « Relancer le bureau » (sans verrouillage).
    FERRITE_DEV=$dev FERRITE_LOCK=$lock $bus "$bin/ferrite-shell" --drm >"$log" 2>&1
    status=$?
    # Après un arrêt imprévu, on repart verrouillé : planter ne doit pas ouvrir la session.
    lock=$lock_default
    # Codes choisis dans le dialogue d'arrêt du bureau (voir PowerAction::exit_code).
    if [ "$status" -eq 3 ]; then
        # « Relancer le bureau » (mode développement seulement) : prend aussi la dernière
        # copie de tools/dev-on.sh. Hors développement, on repart verrouillé.
        [ "$dev" = 1 ] && lock=0
        crashes=0
        dev_crashes=0
        choose_bin
        continue
    fi
    if [ "$status" -eq 4 ] && [ "$greetd" = 1 ]; then
        # « Se déconnecter » : retour à l'écran de connexion.
        exit 0
    fi
    if [ "$status" -eq 4 ]; then
        # « Se déconnecter » : rien d'autre à taper que Entrée pour revenir.
        printf '\n  \033[1mSession fermée.\033[0m\n\n'
        printf '  Entrée : rouvrir la session\n'
        printf '  console puis Entrée : rester sur la console\n\n  '
        read -r answer || answer=console
        [ "$answer" = console ] && break
        crashes=0
        dev_crashes=0
        first=1
        choose_bin
        continue
    fi
    if [ "$status" -eq 0 ]; then
        # En développement, quitter le bureau sert à le relancer ; Ctrl+Alt+F2 donne une console.
        [ "$dev" = 1 ] || { [ "$greetd" = 1 ] && exit 0; break; }
        lock=0
        crashes=0
        dev_crashes=0
        choose_bin
        continue
    fi

    printf "\n  \033[31mLe bureau Ferrite s'est arrêté (code %s).\033[0m Dernières lignes du journal :\n\n" "$status"
    tail -n 15 "$log" | sed 's/^/    /'
    if [ "$dev" = 1 ]; then
        dev_crashes=$((dev_crashes + 1))
        if [ "$dev_crashes" -ge 2 ]; then
            rejected="$bin:$(stat -c %Y "$bin/ferrite-shell")"
            printf '\n  Version de développement écartée : retour aux binaires de %s.\n' "$stable"
            dev_crashes=0
            crashes=0
            choose_bin
            sleep 2
            continue
        fi
    fi
    now=$(date +%s)
    if [ $((now - window_start)) -gt 120 ]; then
        window_start=$now
        crashes=0
    fi
    crashes=$((crashes + 1))
    if [ "$crashes" -ge 3 ]; then
        printf '\n  Arrêts répétés : retour à la console (journal : %s).\n' "$log"
        # Écran de connexion : il reprend la main (une console ici ne se verrait pas).
        [ "$greetd" = 1 ] && exit 1
        break
    fi
    sleep 2
done

printf '\n  \033[1mFerrite OS\033[0m — système live Debian %s, noyau %s\n\n' \
    "$(cat /etc/debian_version)" "$(uname -r)"
printf '  Bureau     ferrite-session       (relance le bureau Ferrite)\n'
printf '  Wi-Fi      nmcli dev wifi list   ·   nmcli dev wifi connect NOM --ask\n'
printf '  Son        wpctl status          ·   speaker-test -c 2 -t wav -l 1\n'
printf '  Matériel   ferrite-check         (vérifications de la phase 1)\n'
printf '  Éteindre   systemctl poweroff\n'
if grep -qw "boot=live" /proc/cmdline 2>/dev/null; then
    printf '  Compte     ferrite, mot de passe ferrite\n'
fi
printf '\n'

exec bash -l
