# Système live
live-boot
live-config
live-config-systemd
systemd-sysv
user-setup
sudo
locales
console-setup
keyboard-configuration
tzdata
ca-certificates
dbus-user-session
dbus-daemon
libpam-systemd

# Noyau et micrologiciels du ThinkBook (Wi-Fi RTL8852BE → rtw89, Intel Iris Xe, son SOF)
linux-image-amd64
intel-microcode
firmware-realtek
firmware-iwlwifi
firmware-intel-graphics
firmware-intel-misc
firmware-intel-sound
firmware-sof-signed
firmware-misc-nonfree

# Autres PC que le ThinkBook (sans eux : pas de Wi-Fi sur les puces Atheros, Broadcom ou
# MediaTek, donc rien à télécharger ensuite).
# Pas de firmware-amd-graphics ni de firmware-nvidia-graphics (55 Mo de paquets, copiés
# aussi dans l'initrd) : la Logithèque les propose sur un PC qui en a besoin (Pilotes).
amd64-microcode
firmware-linux-free
firmware-atheros
firmware-ath9k-htc
firmware-brcm80211
firmware-mediatek
firmware-cirrus
bluez-firmware

# Graphisme et entrées du bureau ferrite-shell
libgl1-mesa-dri
libegl1
libegl-mesa0
libgles2
libgbm1
libinput10
libseat1
libxkbcommon0
libwayland-server0
libwayland-client0
xkb-data
mesa-vulkan-drivers
intel-media-va-driver
# Décodage vidéo par la carte graphique sur AMD (et NVIDIA par nouveau)
mesa-va-drivers
xwayland

# Services système utilisés par le bureau
# Échange compressé en mémoire (zram) : le bureau n'attend plus un SSD lent pour relire
# sa mémoire (voir etc/systemd/zram-generator.conf)
systemd-zram-generator
# Réglages › Date et heure : heure réglée automatiquement par le réseau (NTP)
systemd-timesyncd
network-manager
wpasupplicant
rfkill
iw
brightnessctl
pipewire
pipewire-pulse
pipewire-alsa
pipewire-bin
pulseaudio-utils
curl
wireplumber
# Casques et enceintes Bluetooth (A2DP, HFP) : sans ce module, PipeWire ne crée aucune
# sortie pour eux et BlueZ répond « br-connection-profile-unavailable »
libspa-0.2-bluetooth
# Priorité temps réel du son (évite les craquements)
rtkit
alsa-ucm-conf
bluez
# Fichiers : « Envoyer par Bluetooth » (service obexd, profil Object Push)
bluez-obexd
# Impression sans pilote (Paramètres › Imprimantes) : CUPS, imprimantes réseau, USB récentes
cups
cups-browsed
ipp-usb
upower
# Profils d’énergie (tuile « Économie d’énergie », commande powerprofilesctl)
power-profiles-daemon
udisks2
packagekit
flatpak
# Logithèque : catalogue des applications de Debian (DEP-11 téléchargé par apt update) et
# leurs icônes, y compris en double taille.
appstream
apt-config-icons-hidpi
polkitd
# Lancer une application en administrateur (Fichiers : « Ouvrir en administrateur ») ;
# le mot de passe est demandé par l'agent polkit du bureau.
pkexec
accountsservice
# Écran de connexion : greetd lance ferrite-greeter (choix du compte, mot de passe par PAM)
greetd
# Capture › Texte : reconnaissance du texte d'une zone de l'écran (français, anglais)
tesseract-ocr
tesseract-ocr-fra

# Compatibilité avec les applications Linux : portails (dialogues de fichiers, ouverture
# de liens, captures) et outil de mise à jour de l'environnement D-Bus
xdg-desktop-portal
xdg-desktop-portal-gtk
dbus-bin

# Coffre à mots de passe (Secret Service) : navigateurs, Claude, VS Code y rangent leurs
# identifiants. Démarré par systemd sur le bus de la session (voir ferrite-session) ;
# gcr fournit la fenêtre qui demande de le déverrouiller.
gnome-keyring
libpam-gnome-keyring
gcr

# Disques et clés USB formatés sous Windows (NTFS), en lecture et écriture
ntfs-3g

# Archives ZIP/TAR/RAR dans Fichiers (RAR en lecture via libarchive, création via rar)
libarchive-tools
rar

# Lecteur PDF : pdfinfo (pages), pdftoppm (rendu des pages), pdftotext (recherche)
poppler-utils

# Enregistrement vidéo de l'écran (barre de capture, mode vidéo) par screencopy
wf-recorder

# GStreamer : Lecteur vidéo, Musique et caméra infrarouge de ferrite-visage (v4l2src dans
# plugins-good). libav décode le H.264 des vidéos courantes et des enregistrements d'écran.
# Listés explicitement : jusqu'ici, ils n'arrivaient que par les dépendances d'autres paquets.
libgstreamer1.0-0
libgstreamer-plugins-base1.0-0
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-libav
# AV1 (vidéos 4K de YouTube) : libav ne le décode pas ; plugins-bad apporte le décodeur
# de la carte graphique (vaav1dec) et celui du processeur (av1dec).
gstreamer1.0-plugins-bad

# Réglages transmis aux applications tierces par ferrite-shell (gsettings) : thème clair ou
# sombre et ordre des boutons de fenêtre (fermer à gauche, agrandir à droite).
libglib2.0-bin
gsettings-desktop-schemas
dconf-gsettings-backend

# xhost : ferrite-shell autorise root local sur XWayland, pour que les programmes lancés
# en administrateur par pkexec (GParted…) puissent s'afficher (voir protocols/xwayland.rs).
x11-xserver-utils
# xsettingsd : échelle des programmes GTK sous X11 (GParted) sur un écran ×2, net.
xsettingsd

# Terminal de secours et d'essais (le Terminal du bureau est celui de ferrite-apps)
foot
# Shell des terminaux du bureau : complétion par Tab et suggestions (voir ferrite-session)
fish

# Écran de démarrage (thème « ferrite », hooks/live/0120) ; label : texte des messages
plymouth
plymouth-label

# Polices
fonts-noto-core
fonts-dejavu-core
fonts-noto-color-emoji
# Symboles et emoji du Terminal, qui ne sait pas dessiner les polices en couleur
fonts-symbola
fonts-jetbrains-mono

# Polices du traitement de texte (WordCraft et les autres applications Flatpak les lisent
# dans /run/host/fonts). Mêmes largeurs que les polices de Microsoft, pour qu'un .docx garde
# sa mise en page : Arial, Times New Roman, Courier New (Liberation), Calibri (Carlito),
# Cambria (Caladea), Helvetica, Times, Palatino, Bookman… (URW), Comic Sans (Comic Neue).
fonts-liberation
fonts-crosextra-carlito
fonts-crosextra-caladea
fonts-croscore
fonts-urw-base35
fonts-comic-neue
# Polices de texte avec empattements (livres, lettres, mémoires)
fonts-dejavu-extra
fonts-linuxlibertine
fonts-ebgaramond
fonts-sil-charis
# Polices sans empattements courantes dans les modèles de documents
fonts-open-sans
fonts-roboto
fonts-lato
fonts-adobe-sourcesans3
fonts-ubuntu
fonts-cantarell
fonts-quicksand
# Chasse fixe (code, machine à écrire) et formules mathématiques
fonts-noto-mono
fonts-firacode
fonts-courier-prime
fonts-stix
fonts-cascadia-code
fonts-hack
# Polices de création graphique (affiches, logos, maquettes) et écritures asiatiques
fonts-inter
fonts-montserrat
fonts-league-spartan
fonts-ibm-plex
fonts-cardo
fonts-lobster
fonts-noto-cjk

# Outils de diagnostic (critères de la phase 1)
libinput-tools
pciutils
usbutils
alsa-utils
less
nano
